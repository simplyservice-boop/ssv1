# Application
NODE_ENV=development
PORT=4010
API_URL=https://simplyservice-api.loca.lt
WEB_URL=https://simplyservice-web.loca.lt
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://localhost:4000,http://localhost:4010,http://localhost,https://simplyservice-web.loca.lt,https://simplyservice-api.loca.lt

# Frontend
VITE_API_URL=https://simplyservice-api.loca.lt/api/v1
VITE_MAPBOX_TOKEN=
VITE_SOCKET_URL=https://simplyservice-api.loca.lt

# Database
DATABASE_URL=postgresql://simply_user:simply_pass@localhost:5432/simply_service_db

# JWT
JWT_SECRET=replace_with_a_secure_secret
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=simply-service-assets

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Email / SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM=noreply@simplyservice.io
EMAIL_FROM_NAME=Simply Service

# Socket.io
SOCKET_CORS_ORIGIN=http://localhost:5173
